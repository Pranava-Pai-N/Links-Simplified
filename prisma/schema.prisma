// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  engineType   = "client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model user {
  id            String     @id @default(uuid())
  name          String?
  emailId       String     @unique
  profileImage  String?
  generatedUrls urls[]
  payments      Payments[]
  provider      Provider   @default(google)
  isPremium     Boolean    @default(false)
  validTill     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model urls {
  id           String  @id
  shortId      String? @unique
  customId     String?
  customDomain Boolean @default(false)
  originalURL  String
  redirectURL  String
  active       Boolean @default(true)
  activeClicks Int     @default(0)

  // Relations
  createdBy String
  user      user   @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payments {
  orderId          String        @id @default(uuid())
  gatewayPaymentId String?       @unique // For webhooks
  provider         String        @default("Razorpay")
  amount           Int
  currency         String        @default("INR")
  status           PaymentStatus @default(PENDING)
  hostedInvoiceUrl String? // PDF Link by razorpay
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  paidAt           DateTime?
  validtill        DateTime?
  receipt          String?

  // Relation
  paidBy String
  user   user   @relation(fields: [paidBy], references: [id])

  @@index([status])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum Provider {
  google
  github
}
